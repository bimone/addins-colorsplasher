<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Color Splasher - BIM One Revit add-in.
    Multi-version build. Pick the Revit version with the build configuration:
      Debug/Release R23  -> Revit 2023 (.NET Framework 4.8)
      Debug/Release R24  -> Revit 2024 (.NET Framework 4.8)
      Debug/Release R25  -> Revit 2025 (.NET 8)
      Debug/Release R26  -> Revit 2026 (.NET 8)
    Example:  dotnet build -c "Release R26"
  -->

  <PropertyGroup>
    <AssemblyName>ColorSplasher</AssemblyName>
    <RootNamespace>ColorSplasher</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Windows-only add-in; silence cross-platform CA1416 noise from WinForms APIs -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon>ColorSplasherIcon.ico</ApplicationIcon>
    <Configurations>Debug R23;Debug R24;Debug R25;Debug R26;Release R23;Release R24;Release R25;Release R26</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Release R26</Configuration>
  </PropertyGroup>

  <!-- Revit version / target framework selected by the configuration name -->
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <Optimize Condition="$(Configuration.StartsWith('Release'))">true</Optimize>
  </PropertyGroup>

  <!-- Revit API (compile-only; Revit ships these assemblies at runtime) -->
  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2023.0.0" Condition="'$(RevitVersion)' == '2023'" ExcludeAssets="runtime" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.2.0" Condition="'$(RevitVersion)' == '2024'" ExcludeAssets="runtime" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0" Condition="'$(RevitVersion)' == '2025'" ExcludeAssets="runtime" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2026.0.0" Condition="'$(RevitVersion)' == '2026'" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Lets net48 build without the .NET Framework targeting pack installed -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Images/icons embedded as WPF resources (referenced via pack URIs in XAML) -->
  <ItemGroup>
    <Resource Include="logo.ico" />
    <Resource Include="ColorSplasherIcon.ico" />
    <Resource Include="Resources\button.ico" />
    <Resource Include="Resources\TooIconNoNewVersionMiniGray.png" />
    <Resource Include="Resources\ToolIconExitMiniGray.png" />
    <Resource Include="Resources\ToolIconHelpMini.png" />
    <Resource Include="Resources\ToolIconHelpMiniGray.png" />
    <Resource Include="Resources\ToolIconNewVersionMini.png" />
    <Resource Include="Resources\ToolIconNewVersionMiniGray.png" />
    <Resource Include="Resources\ToolIconNoConnectMini.png" />
    <Resource Include="Resources\ToolIconNoConnectMiniGray.png" />
    <Resource Include="Resources\ToolIconSupportMiniGray.png" />
    <Resource Include="Resources\1_inactive.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\2_inactive.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\3_inactive.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\4_inactive.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\1_active.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\2_active.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\3_active.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\4_active.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\logo.ico"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
    <Resource Include="Resources\logo.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Resource>
  </ItemGroup>

  <!-- Images loaded from disk at runtime (must sit next to the DLL) -->
  <ItemGroup>
    <Content Include="Resources\button.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Resources\apps.gif"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Include="Resources\bimone.gif"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Include="Resources\mail.gif"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
  </ItemGroup>

  <!-- Localization fix: embed the French resx into the fr satellite under the NEUTRAL base
       name ("ColorSplasher.Resource.resources") so the standard culture fallback used by the
       Resource class actually finds it under a French UI culture. As shipped it embedded as
       "ColorSplasher.Resource.fr.resources", which the runtime never looks up, so French
       silently fell back to English. Culture routes it to the fr satellite; LogicalName sets
       the embedded name and keeps the obj intermediate distinct from the neutral resource. -->
  <ItemGroup>
    <EmbeddedResource Update="Resource.fr.resx">
      <Culture>fr</Culture>
      <LogicalName>ColorSplasher.Resource.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Deploy to the local Revit add-ins folder on Debug builds only -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="$(Configuration.StartsWith('Debug'))">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(ProjectDir)Addin.addin" DestinationFiles="$(RevitAddinsDir)\ColorSplasher.addin" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(RevitAddinsDir)\ColorSplasher\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
